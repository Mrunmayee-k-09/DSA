#include<vector>
using namespace std;

class Solution {
public:
    vector<int> getConcatenation(vector<int>& nums) {
        int i,j;
        int n = nums.size();
        vector<int>ans;
        for(i=0; i<n; i++) {
            ans.push_back(nums[i]);
        }
        for(i=0; i<n; i++) {
            ans.push_back(nums[i]);
        }
        return ans;
    }
};